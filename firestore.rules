rules_version = '2';

// Setiap pengguna hanya bisa membaca dan menulis catatannya sendiri: users/{uid}/goals dan users/{uid}/transactions.
// Tempel isi file ini di Firebase Console → Firestore Database → Rules, lalu Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && collection in ['goals', 'transactions'];
    }
  }
}
