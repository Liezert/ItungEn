<?xml version="1.0" encoding="utf-8"?>
<!-- Hanya build "bench" (pengukuran performa): bisa diprofilkan dan punya pengisi data uji. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Label beda agar tidak tertukar dengan ItungEn asli di HP yang sama. -->
    <application
        android:label="ItungEn Bench"
        tools:replace="android:label">
        <profileable android:shell="true" />
        <!-- adb shell am broadcast -n com.liezert.itungen.bench/com.liezert.itungen.BenchSeedReceiver -\-ei count 30000 -->
        <receiver
            android:name=".BenchSeedReceiver"
            android:exported="true" />
    </application>
</manifest>
